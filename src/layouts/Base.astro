---
import '@fontsource-variable/source-sans-3/wght.css';
import displayFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// Absolute URL of the deployed site root, base-aware so the GitHub Pages
// mirror (/simplex/) gets correct canonical, logo and icon links.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = Astro.site ? new URL(base, Astro.site).href : site.siteUrl;
const logo = new URL('logo.png', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  legalName: site.legalName,
  url: siteUrl,
  logo,
  image: logo,
  telephone: site.contacts.map((c) => c.phone),
  email: site.email,
  sameAs: [site.instagram],
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Near AR Hospital, Chandapura',
    addressLocality: 'Kodungallur',
    addressRegion: 'Kerala',
    addressCountry: 'IN',
  },
  areaServed: 'Kerala, India',
  ...(site.hours ? { openingHours: site.hours } : {}),
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#e3e3de" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${base}favicon-192.png`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={logo} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/register';
    </script>
  </body>
</html>
