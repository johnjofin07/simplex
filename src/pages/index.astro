---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhyRow from '../components/WhyRow.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Design from '../components/Design.astro';
import Close from '../components/Close.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';
import { site } from '../content/site';
---

<Base
  title={`${site.name} — aluminium fabrication in Kerala since 1993`}
  description="Structural glazing, aluminium windows and doors, ACP cupboards, kitchens, interiors and car porches across Kerala. Free site visit, free quotation and 3D design before work. Kodungallur, since 1993."
>
  <Nav />
  <main id="main">
    <Hero />
    <WhyRow />
    <Services />
    <Process />
    <Design />
    <Close />
  </main>
  <Footer />
  <BottomBar />
</Base>
