---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhyRow from '../components/WhyRow.astro';
import Services from '../components/Services.astro';
import Spaces from '../components/Spaces.astro';
import Process from '../components/Process.astro';
import SectionDrawing from '../components/SectionDrawing.astro';
import Close from '../components/Close.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';
import { site } from '../content/site';
---

<Base
  title={`${site.name} — windows, doors and interiors in aluminium`}
  description="Aluminium windows, doors and sealing, cupboards and wardrobes, and whole interiors. Measured on site, fabricated in our workshop, fitted clean. Call or WhatsApp."
>
  <Nav />
  <main id="main">
    <Hero />
    <WhyRow />
    <Services />
    <Spaces />
    <Process />
    <SectionDrawing />
    <Close />
  </main>
  <Footer />
  <BottomBar />
</Base>
