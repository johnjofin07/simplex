---
/**
 * The page's one photo viewer. Rendered once (from Services.astro) and driven
 * from src/scripts/register.ts: any `a[data-lb-album="<key>"]` opens it on the
 * photos listed in the matching `script[data-lb-album="<key>"]` JSON block.
 */
import Icon from './Icon.astro';
---

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <div class="frame" data-lb-frame>
    <img class="lb-img" data-lb-img alt="" decoding="async" />
  </div>
  <button class="lb-btn close" type="button" data-lb-close aria-label="Close"><Icon name="close" size={22} /></button>
  <div class="bar wrap">
    <div class="text">
      <span class="label" data-lb-title></span>
      <p class="small" data-lb-caption></p>
    </div>
    <div class="ctl">
      <span class="label" data-lb-count aria-live="polite"></span>
      <button class="lb-btn" type="button" data-lb-prev aria-label="Previous photo"><Icon name="arrow-left" size={20} /></button>
      <button class="lb-btn" type="button" data-lb-next aria-label="Next photo" autofocus><Icon name="arrow" size={20} /></button>
    </div>
  </div>
</dialog>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--on-ink);
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgba(20, 21, 19, 0.96);
  }
  .lightbox :focus-visible {
    outline-color: var(--on-ink);
  }
  .frame {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 84px 96px 116px;
  }
  .lb-img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--r);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    transition: opacity 0.25s ease;
  }
  .lightbox.is-loading .lb-img {
    opacity: 0;
  }
  .lb-img:not([src]) {
    display: none;
  }
  .lb-btn {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--on-ink);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background-color var(--t-fast) ease,
      color var(--t-fast) ease;
  }
  .lb-btn:hover {
    background: var(--on-ink);
    color: var(--ink);
  }
  .close {
    position: absolute;
    top: 20px;
    right: 24px;
  }
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px 24px;
    padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .text .label {
    color: var(--on-ink-2);
  }
  .text p {
    color: var(--on-ink);
    max-width: 40em;
  }
  .ctl {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ctl .label {
    color: var(--on-ink-2);
    margin-right: 8px;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 1100px) {
    .frame {
      padding: 76px 24px 116px;
    }
  }
  @media (max-width: 720px) {
    .frame {
      padding: 68px 12px 132px;
    }
    .close {
      top: 12px;
      right: 12px;
    }
    .bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding-block: 12px 16px;
      padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }
    .ctl {
      width: 100%;
      justify-content: space-between;
    }
    .ctl .label {
      margin-right: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-img {
      transition: none;
    }
  }
</style>
