---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, telHref, waHref } from '../content/site';
---

<header class="nav">
  <div class="wrap row">
    <a class="brand" href="#top" aria-label={`${site.name}, top of page`}>
      <Logo height={34} />
      <span class="wordmark">{site.wordmark}</span>
    </a>
    <nav class="links desktop-only" aria-label="Sections">
      {site.nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <Button href={waHref} variant="ghost" icon="whatsapp" class="desktop-only">WhatsApp</Button>
      <Button href={telHref} variant="primary" icon="phone" class="nav-call">Call now</Button>
      <button class="menu-btn mobile-only" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Sections menu">
        <Icon name="menu" size={22} class="ico-open" />
        <Icon name="close" size={22} class="ico-close" />
      </button>
    </div>
  </div>
  <nav class="menu mobile-only" id="menu" data-menu hidden aria-label="Sections">
    {site.nav.map((l) => <a href={l.href}>{l.label}</a>)}
    <a class="wa" href={waHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp us</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .row {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
  }
  .wordmark {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .links {
    display: flex;
    gap: 36px;
  }
  .links a {
    position: relative;
    font-size: 16px;
    font-weight: 600;
    padding-block: 6px;
    white-space: nowrap;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .links a:hover::after,
  .links a:focus-visible::after {
    transform: scaleX(1);
  }
  .actions {
    justify-self: end;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .menu-btn,
  .menu {
    display: none;
  }
  @media (max-width: 1040px) {
    .row {
      grid-template-columns: 1fr auto;
    }
    .menu-btn {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid var(--ink);
      color: var(--ink);
    }
    .menu-btn :global(.ico-close),
    .menu-btn[aria-expanded='true'] :global(.ico-open) {
      display: none;
    }
    .menu-btn[aria-expanded='true'] :global(.ico-close) {
      display: block;
    }
    .menu {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 8px var(--margin) 16px;
      background: color-mix(in srgb, var(--paper) 96%, transparent);
      backdrop-filter: saturate(140%) blur(12px);
      -webkit-backdrop-filter: saturate(140%) blur(12px);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 40px rgba(20, 21, 19, 0.12);
    }
    .menu[hidden] {
      display: none;
    }
    .menu :global(a) {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 0;
      font-size: 18px;
      font-weight: 600;
      border-bottom: 1px solid var(--line);
    }
    .menu :global(a:last-child) {
      border-bottom: 0;
    }
    .menu .wa {
      margin-top: 8px;
      padding: 12px 0 4px;
      font-size: 16px;
    }
    /* Once the sections collapse into the menu, the header keeps only the
       menu button. Call lives in the hero and the bottom bar. */
    .actions :global(.nav-call) {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .brand {
      gap: 10px;
    }
    .brand :global(svg) {
      height: 28px;
      width: auto;
    }
    .wordmark {
      font-size: 19px;
    }
  }
</style>
