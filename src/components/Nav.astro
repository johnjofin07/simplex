---
import Button from './Button.astro';
import Logo from './Logo.astro';
import { site, telHref, waHref } from '../content/site';
---

<header class="nav">
  <div class="wrap row">
    <a class="brand" href="#top" aria-label={`${site.name} — top of page`}>
      <Logo height={34} />
      <span class="wordmark">{site.wordmark}</span>
    </a>
    <nav class="links desktop-only" aria-label="Sections">
      {site.nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <Button href={waHref} variant="ghost" icon="whatsapp" class="desktop-only">WhatsApp</Button>
      <Button href={telHref} variant="primary" icon="phone">Call now</Button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .row {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
  }
  .wordmark {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .links {
    display: flex;
    gap: 36px;
  }
  .links a {
    position: relative;
    font-size: 16px;
    font-weight: 600;
    padding-block: 6px;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .links a:hover::after,
  .links a:focus-visible::after {
    transform: scaleX(1);
  }
  .actions {
    justify-self: end;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr auto;
    }
    .brand {
      gap: 10px;
    }
    .brand :global(svg) {
      height: 28px;
      width: auto;
    }
    .wordmark {
      font-size: 19px;
    }
    .actions :global(.btn) {
      height: 42px;
      padding-inline: 18px;
      font-size: 15px;
    }
  }
</style>
