---
import Icon from './Icon.astro';
import { site } from '../content/site';
---

<section class="band sheet" id="why" aria-labelledby="why-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="why-h" class="h2" data-reveal style="--d: 0.06s">{site.why.headline}</h2>
      <div class="aside" data-reveal style="--d: 0.12s">
        <p class="body">{site.why.sub}</p>
      </div>
    </div>
    <ul class="points">
      {site.why.points.map((p, i) => (
        <li data-reveal style={`--d: ${0.08 * i}s`}>
          <Icon name={p.icon} size={28} />
          <h3 class="h3">{p.title}</h3>
          <p class="small muted">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .points {
    margin-top: 72px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 40px;
  }
  .points li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .points svg {
    margin-bottom: 10px;
  }
  .points p {
    max-width: 22em;
  }
  @media (max-width: 1100px) {
    .points {
      margin-top: 64px;
    }
  }
  @media (max-width: 720px) {
    .points {
      margin-top: 48px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
  }
  @media (max-width: 360px) {
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
