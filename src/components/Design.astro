---
/**
 * You see it finished before we begin. Simplex's own 3D designs, shown as a
 * horizontal card row.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { site, waHref } from '../content/site';
import { designPhotos } from '../content/gallery';

// Designs come from src/content/designs/ (managed at /admin).
const designs = await designPhotos();
---

<section class="band greige" id="design" aria-labelledby="design-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="design-h" class="h2" data-reveal style="--d: 0.06s">{site.design.headline}</h2>
      <div class="aside" data-reveal style="--d: 0.12s">
        <p class="body">{site.design.sub}</p>
        <Button href={waHref} icon="whatsapp">Ask for a 3D design</Button>
        <div class="steps" data-scroller-controls="design-track">
          <button class="step" type="button" data-dir="-1" aria-label="Previous designs"><Icon name="arrow-left" size={18} /></button>
          <span class="track-line" aria-hidden="true"><span class="thumb" /></span>
          <button class="step" type="button" data-dir="1" aria-label="Next designs"><Icon name="arrow" size={18} /></button>
        </div>
      </div>
    </div>
  </div>
  <div class="scroller" id="design-track" data-scroller tabindex="0" aria-label="3D designs, horizontal list">
    <ul class="track">
      {designs.map((d, i) => (
        <li data-reveal style={`--d: ${0.07 * i}s`}>
          <figure class="photo card">
            <Image src={d.src} alt={d.alt} widths={[560, 900, 1200]} sizes="(max-width: 720px) 84vw, 560px" format="webp" quality={76} loading="lazy" decoding="async" />
            <figcaption class="cap pill">{d.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .steps {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: 320px;
  }
  .step {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    display: grid;
    place-items: center;
    transition:
      background-color var(--t-fast) ease,
      color var(--t-fast) ease,
      opacity var(--t-fast) ease;
  }
  .step:hover {
    background: var(--ink);
    color: var(--on-ink);
  }
  .step[disabled] {
    opacity: 0.3;
    pointer-events: none;
  }
  .track-line {
    flex: 1;
    height: 1px;
    background: var(--line);
    position: relative;
  }
  .thumb {
    position: absolute;
    top: -1px;
    left: 0;
    height: 3px;
    width: var(--thumb-w, 40%);
    transform: translateX(var(--thumb-x, 0));
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.4s var(--ease);
  }
  .scroller {
    margin-top: 64px;
    /* Horizontal only: the reveal transform on the cards would otherwise make
       this a vertical scroll container too. The padding gives that transform
       room to sit inside the clip box; the margin takes the space back. */
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 18px;
    margin-bottom: -18px;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: max(var(--margin), calc((100vw - var(--max)) / 2 + var(--margin)));
    scroll-padding-inline: max(var(--margin), calc((100vw - var(--max)) / 2 + var(--margin)));
  }
  .scroller::-webkit-scrollbar {
    display: none;
  }
  .track {
    display: flex;
    gap: var(--gutter);
    width: max-content;
    padding-bottom: 4px;
  }
  .track li {
    flex: none;
    width: 560px;
    scroll-snap-align: start;
  }
  .card {
    aspect-ratio: 5 / 4;
  }
  .card img {
    object-position: 50% 0;
  }
  @media (max-width: 1100px) {
    .scroller {
      margin-top: 48px;
    }
    .track li {
      width: 480px;
    }
  }
  @media (max-width: 720px) {
    .scroller {
      margin-top: 36px;
    }
    .track li {
      width: 84vw;
    }
    .steps {
      max-width: none;
    }
  }
</style>
