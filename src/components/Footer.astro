---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../content/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="row top">
      <a class="brand" href="#top" aria-label={`${site.name} — top of page`}>
        <Logo height={44} />
        <span class="wordmark">{site.wordmark}</span>
      </a>
      <nav class="links" aria-label="Footer">
        {site.nav.map((l) => <a class="small" href={l.href}>{l.label}</a>)}
      </nav>
    </div>

    <div class="row contact">
      <div class="col">
        <p class="label">Call or WhatsApp</p>
        {site.contacts.map((c) => (
          <p class="small">
            <a href={`tel:${c.phone}`}>{c.display}</a>
            <span class="muted"> · {c.name}</span>
          </p>
        ))}
      </div>
      <div class="col">
        <p class="label">Workshop</p>
        <p class="small">{site.legalName}</p>
        {site.address.map((l) => <p class="small muted">{l}</p>)}
      </div>
      <div class="col">
        <p class="label">Write to us</p>
        <p class="small"><a href={`mailto:${site.email}`}><Icon name="mail" size={16} /> {site.email}</a></p>
        <p class="small"><a href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={16} /> {site.instagramHandle}</a></p>
      </div>
    </div>

    <p class="small muted note">© {year} {site.legalName}. Kodungallur, Kerala. Since {site.founded}.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--greige);
    padding-block: 40px 48px;
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 40px;
  }
  .top {
    justify-content: space-between;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .wordmark {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .links a {
    font-weight: 600;
    white-space: nowrap;
  }
  .contact {
    align-items: flex-start;
    gap: 24px 56px;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .col p {
    margin: 0;
  }
  .col .label {
    margin-bottom: 8px;
  }
  .col a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .links a:hover,
  .col a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .note {
    margin-top: 32px;
  }
  @media (max-width: 720px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .contact {
      gap: 22px;
    }
  }
</style>
