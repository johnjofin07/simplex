---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { site, telHref, waHref } from '../content/site';
import { photos } from '../content/photos';
const p = photos[site.close.photo];
---

<section class="band paper" id="contact" aria-labelledby="contact-h">
  <div class="wrap">
    <div class="panel" data-reveal>
      <div class="copy">
        <h2 id="contact-h" class="h2">{site.close.headline}</h2>
        <p class="body sub">{site.close.sub}</p>
        <div class="cta">
          <Button href={telHref} variant="light" icon="phone" size="lg">Call {site.phoneDisplay}</Button>
          <Button href={waHref} variant="secondary" icon="whatsapp" size="lg" class="on-dark">WhatsApp</Button>
        </div>
        <dl class="details">
          <div>
            <dt class="label">Call or WhatsApp</dt>
            <dd>
              {site.contacts.map((c) => (
                <span class="line who"><a href={`tel:${c.phone}`}>{c.display}</a><span class="name">{c.name}</span></span>
              ))}
            </dd>
          </div>
          <div>
            <dt class="label">Workshop</dt>
            <dd>
              <span class="line">{site.legalName}</span>
              {site.address.map((l) => <span class="line">{l}</span>)}
            </dd>
          </div>
          <div>
            <dt class="label">Email and Instagram</dt>
            <dd>
              <span class="line"><a href={`mailto:${site.email}`}>{site.email}</a></span>
              <span class="line"><a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></span>
            </dd>
          </div>
          {site.hours && <div><dt class="label">Hours</dt><dd>{site.hours}</dd></div>}
          <div><dt class="label">Service area</dt><dd>{site.serviceArea}</dd></div>
        </dl>
      </div>
      <figure class="photo art">
        <Image src={p.src} alt={p.alt} widths={[600, 1000, 1400]} sizes="(max-width: 1100px) 100vw, 46vw" format="webp" quality={76} loading="lazy" decoding="async" />
      </figure>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--gutter);
    padding: 24px;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: calc(var(--r) + 10px);
  }
  .copy {
    padding: 40px 40px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }
  .copy .label {
    color: var(--on-ink-2);
  }
  .sub {
    max-width: 30em;
    color: var(--on-ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .cta :global(.on-dark) {
    color: var(--on-ink);
    border-color: var(--on-ink-2);
  }
  .cta :global(.on-dark:hover) {
    background: var(--white);
    color: var(--ink);
    border-color: var(--white);
  }
  .details {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
  }
  .details dt {
    color: var(--on-ink-2);
    margin-bottom: 8px;
  }
  .details dd {
    font-size: var(--small-size);
    line-height: var(--small-lh);
  }
  .details .line {
    display: block;
  }
  .details .who + .who {
    margin-top: 6px;
  }
  .details .name {
    display: block;
    color: var(--on-ink-2);
  }
  .details a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .art {
    min-height: 420px;
    border-radius: var(--r);
  }
  .art img {
    position: absolute;
    inset: 0;
    height: 100%;
    object-position: 50% 62%;
  }
  @media (max-width: 1100px) {
    .panel {
      grid-template-columns: 1fr;
      padding: 16px;
    }
    .copy {
      padding: 28px 20px 20px;
      order: 1;
    }
    .art {
      order: 0;
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 720px) {
    .copy {
      padding: 20px 8px 8px;
      gap: 22px;
    }
    .cta :global(.btn) {
      width: 100%;
    }
    .details {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .art {
      aspect-ratio: 4 / 3;
    }
  }
</style>
