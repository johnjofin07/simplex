---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { site, telHref, waHref } from '../content/site';
import { photos } from '../content/photos';
const p = photos[site.close.photo];
---

<section class="band paper" id="contact" aria-labelledby="contact-h">
  <div class="wrap">
    <div class="panel" data-reveal>
      <div class="copy">
        <h2 id="contact-h" class="h2">{site.close.headline}</h2>
        <p class="body sub">{site.close.sub}</p>
        <div class="cta">
          <Button href={telHref} variant="light" icon="phone" size="lg">Call {site.phoneDisplay}</Button>
          <Button href={waHref} variant="secondary" icon="whatsapp" size="lg" class="on-dark">WhatsApp</Button>
        </div>
        <dl class="details">
          <div><dt class="label">Workshop</dt><dd>{site.address[0]}<br />{site.address[1]}</dd></div>
          <div><dt class="label">Hours</dt><dd>{site.hours}</dd></div>
          <div><dt class="label">Service area</dt><dd>{site.serviceArea}</dd></div>
          {site.email && <div><dt class="label">Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>}
        </dl>
      </div>
      <figure class="photo art">
        <Image src={p.src} alt={p.alt} widths={[600, 1000, 1600]} sizes="(max-width: 1100px) 100vw, 46vw" format="webp" quality={76} loading="lazy" decoding="async" />
      </figure>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--gutter);
    padding: 24px;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: calc(var(--r) + 10px);
  }
  .copy {
    padding: 40px 40px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }
  .copy .label {
    color: var(--on-ink-2);
  }
  .sub {
    max-width: 30em;
    color: var(--on-ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .cta :global(.on-dark) {
    color: var(--on-ink);
    border-color: var(--on-ink-2);
  }
  .cta :global(.on-dark:hover) {
    background: var(--white);
    color: var(--ink);
    border-color: var(--white);
  }
  .details {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
  }
  .details dt {
    color: var(--on-ink-2);
    margin-bottom: 8px;
  }
  .details dd {
    font-size: var(--small-size);
    line-height: var(--small-lh);
  }
  .art {
    min-height: 420px;
    border-radius: var(--r);
  }
  .art img {
    height: 100%;
    object-position: 78% center;
  }
  @media (max-width: 1100px) {
    .panel {
      grid-template-columns: 1fr;
      padding: 16px;
    }
    .copy {
      padding: 28px 20px 20px;
      order: 1;
    }
    .art {
      order: 0;
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 720px) {
    .copy {
      padding: 20px 8px 8px;
      gap: 22px;
    }
    .cta :global(.btn) {
      width: 100%;
    }
    .details {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .art {
      aspect-ratio: 4 / 3;
    }
  }
</style>
