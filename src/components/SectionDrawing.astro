---
/**
 * Where the weather stops. A technical section of a two-track aluminium
 * sliding window: A) plan section through both jambs and the interlock,
 * B) vertical section through the sill showing tracks, rollers and a drain
 * slot. Strokes draw themselves along real path lengths (register.ts).
 */
import { site } from '../content/site';
---

<section class="band sheet" id="section" aria-labelledby="section-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="section-h" class="h2" data-reveal style="--d: 0.06s">{site.section.headline}</h2>
      <div class="aside" data-reveal style="--d: 0.12s">
        <p class="body">{site.section.lines[0]}</p>
      </div>
    </div>
    <div class="grid body-grid">
      <div class="card" data-reveal>
        <p class="small muted pan-cue" aria-hidden="true">Drag to pan →</p>
        <div class="drawing-col" data-drawing>
          <svg class="drawing" viewBox="0 0 1200 592" role="img" aria-labelledby="drawing-title drawing-desc">
          <title id="drawing-title">Technical section of a two-track aluminium sliding window</title>
          <desc id="drawing-desc">
            Plan section through the outer frame, the outer and inner sashes and the interlock with its pile seal, with glass and
            gaskets, and a vertical section through the sill showing the two tracks, the rollers and a drain slot.
          </desc>

          <!-- ================= A · PLAN SECTION ================= -->
          <text class="t" x="40" y="26">A · Plan section · two-track sliding window</text>

          <!-- Left jamb, 30 × 60 mm, two chambers -->
          <rect class="l" x="40" y="80" width="60" height="120" />
          <rect class="l" x="46" y="86" width="48" height="108" />
          <path class="l" d="M46 140h48" />

          <!-- Outer sash, jamb-side stile, 32 × 29 mm -->
          <rect class="l" x="100" y="84" width="64" height="58" />
          <rect class="l" x="106" y="90" width="52" height="46" />
          <!-- glazing gasket, EPDM -->
          <rect class="l" x="158" y="104" width="6" height="18" />
          <!-- glass, 5 mm, outer sash -->
          <path class="l" d="M164 108H360M164 118H360" />

          <!-- break, left -->
          <path class="l" d="M366 70l-6 18 12 18-12 18 12 18-12 18 12 18-12 18 6 18" />
          <path class="l" d="M382 70l-6 18 12 18-12 18 12 18-12 18 12 18-12 18 6 18" />

          <!-- outer sash glass continues to the interlock -->
          <path class="l" d="M382 108H560M382 118H560" />
          <rect class="l" x="560" y="104" width="6" height="18" />
          <!-- Outer sash, interlock stile -->
          <rect class="l" x="560" y="84" width="64" height="58" />
          <rect class="l" x="566" y="90" width="52" height="46" />

          <!-- pile seal between the sashes -->
          <rect class="l" x="582" y="141" width="36" height="6" />
          <path class="l" d="M586 141v6M590 141v6M594 141v6M598 141v6M602 141v6M606 141v6M610 141v6M614 141v6" />

          <!-- Inner sash, interlock stile -->
          <rect class="l" x="576" y="146" width="64" height="58" />
          <rect class="l" x="582" y="152" width="52" height="46" />
          <rect class="l" x="634" y="166" width="6" height="18" />
          <!-- glass, inner sash -->
          <path class="l" d="M640 170H850M640 180H850" />

          <!-- break, right -->
          <path class="l" d="M856 70l-6 18 12 18-12 18 12 18-12 18 12 18-12 18 6 18" />
          <path class="l" d="M872 70l-6 18 12 18-12 18 12 18-12 18 12 18-12 18 6 18" />

          <path class="l" d="M872 170H1036M872 180H1036" />
          <rect class="l" x="1036" y="166" width="6" height="18" />
          <!-- Inner sash, jamb-side stile -->
          <rect class="l" x="1036" y="146" width="64" height="58" />
          <rect class="l" x="1042" y="152" width="52" height="46" />

          <!-- Right jamb -->
          <rect class="l" x="1100" y="80" width="60" height="120" />
          <rect class="l" x="1106" y="86" width="48" height="108" />
          <path class="l" d="M1106 140h48" />

          <!-- Dimension: frame depth, 60 mm -->
          <path class="l" d="M22 80v120M16 80h12M16 200h12" />
          <path class="l" d="M22 80l-3 8M22 80l3 8M22 200l-3-8M22 200l3-8" />
          <text class="t" transform="rotate(-90 12 140)" x="12" y="140" text-anchor="middle">Frame 60 mm</text>

          <!-- Dimension: sash, 32 mm -->
          <path class="l" d="M100 226h64M100 220v12M164 220v12" />
          <path class="l" d="M100 226l8-3M100 226l8 3M164 226l-8-3M164 226l-8 3" />
          <text class="t" x="100" y="252">Sash 32 mm</text>

          <!-- Leaders and labels -->
          <text class="t" x="40" y="62">Outer frame</text>
          <path class="l" d="M240 108V70" />
          <text class="t" x="230" y="62">Glass 5 mm · EPDM gasket</text>
          <text class="t" x="500" y="62">Outer sash</text>
          <text class="t" x="1160" y="62" text-anchor="end">Outside</text>
          <path class="l" d="M600 147V232" />
          <text class="t" x="560" y="252">Interlock · pile seal</text>
          <text class="t" x="900" y="252">Inner sash</text>
          <text class="t" x="1160" y="252" text-anchor="end">Inside</text>

          <!-- ================= B · SILL, VERTICAL SECTION ================= -->
          <text class="t" x="200" y="318">B · Sill · vertical section</text>

          <!-- glass rising from both sashes -->
          <path class="l" d="M250 330V396M265 330V396" />
          <path class="l" d="M382 330V396M397 330V396" />
          <!-- glazing gaskets -->
          <rect class="l" x="244" y="376" width="6" height="16" />
          <rect class="l" x="265" y="376" width="6" height="16" />
          <rect class="l" x="376" y="376" width="6" height="16" />
          <rect class="l" x="397" y="376" width="6" height="16" />

          <!-- outer sash bottom rail on track 1 -->
          <rect class="l" x="216" y="376" width="82" height="90" />
          <path class="l" d="M221 396h73v65h-73z" />
          <circle class="l" cx="257" cy="462" r="8" />
          <!-- inner sash bottom rail on track 2 -->
          <rect class="l" x="348" y="376" width="82" height="90" />
          <path class="l" d="M353 396h73v65h-73z" />
          <circle class="l" cx="389" cy="462" r="8" />

          <!-- sill profile: front lip, two track rails, back upstand, hollow body -->
          <path class="l" d="M200 450h6v50h48v-30h6v30h126v-30h6v30h42v-70h6v90h-240z" />
          <rect class="l" x="206" y="506" width="228" height="8" />

          <!-- drain slot through the front lip -->
          <rect class="cut" x="197" y="487" width="12" height="8" />
          <path class="l" d="M250 491H176M184 486l-8 5 8 5" />
          <text class="t" x="168" y="495" text-anchor="end">Drain slot</text>

          <!-- roller leader -->
          <path class="l" d="M397 462H470" />
          <text class="t" x="478" y="466">Roller</text>

          <!-- Dimension: sill depth, 60 mm -->
          <path class="l" d="M200 540h240M200 534v12M440 534v12" />
          <path class="l" d="M200 540l8-3M200 540l8 3M440 540l-8-3M440 540l-8 3" />
          <text class="t" x="320" y="562" text-anchor="middle">Sill 60 mm</text>
          <text class="t" x="200" y="588">Outside</text>
          <text class="t" x="440" y="588" text-anchor="end">Inside</text>
      </svg>
        </div>
      </div>
      <div class="notes" data-reveal style="--d: 0.1s">
        {site.section.lines.slice(1).map((l) => <p class="body muted">{l}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .body-grid {
    margin-top: 72px;
    align-items: start;
    row-gap: var(--gutter);
  }
  .card {
    grid-column: 1 / span 8;
    background: var(--white);
    border-radius: var(--r);
    padding: 40px 40px 32px;
    position: relative;
  }
  .drawing {
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .drawing .l {
    vector-effect: non-scaling-stroke;
  }
  .drawing .cut {
    fill: var(--white);
    stroke: none;
  }
  .drawing .t {
    fill: var(--ink-2);
    stroke: none;
    font-family: var(--font);
    font-weight: 600;
    /* impeccable-disable-next-line design-system-font-size: SVG user units, renders at ~11px */
    font-size: 17px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  :global(html.js) [data-drawing] .l {
    stroke-dasharray: var(--len, 1);
    stroke-dashoffset: var(--len, 0);
  }
  :global(html.js) [data-drawing].is-in .l {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur, 0.4s) linear var(--delay, 0s);
  }
  :global(html.js) [data-drawing] .t,
  :global(html.js) [data-drawing] .cut {
    visibility: hidden;
  }
  :global(html.js) [data-drawing].is-in .t,
  :global(html.js) [data-drawing].is-in .cut {
    visibility: visible;
    transition: visibility 0s linear var(--total, 2s);
  }
  .pan-cue {
    display: none;
  }
  .notes {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 8px;
  }
  .notes p {
    max-width: 24em;
  }
  @media (max-width: 1100px) {
    .body-grid {
      margin-top: 56px;
    }
    .card {
      grid-column: 1 / -1;
    }
    .notes {
      grid-column: 1 / span 8;
      flex-direction: row;
      gap: var(--gutter);
    }
  }
  @media (max-width: 720px) {
    .body-grid {
      margin-top: 40px;
    }
    .card {
      padding: 20px 16px 16px;
    }
    .pan-cue {
      display: block;
      margin-bottom: 8px;
    }
    .drawing-col {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      margin-inline: -16px;
      padding-inline: 16px;
    }
    .drawing-col::-webkit-scrollbar {
      display: none;
    }
    .drawing {
      min-width: 900px;
      scroll-snap-align: start;
    }
    .notes {
      grid-column: 1 / -1;
      flex-direction: column;
      gap: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-drawing] .l {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      transition: none;
    }
    :global(html.js) [data-drawing] .t,
    :global(html.js) [data-drawing] .cut {
      visibility: visible;
    }
  }
</style>
