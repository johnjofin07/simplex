---
/**
 * First screen. Three layers (register.ts sets --py and --ty): the sky at the
 * back and the headline in the middle linger as you scroll, while the building
 * cutout in front moves with the page, so it rises up over the text.
 */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { site, telHref, waHref } from '../content/site';
import { photos } from '../content/photos';
const sky = photos[site.hero.photo];
const building = photos[site.hero.building];
---

<section class="hero" id="top" aria-labelledby="hero-h" data-parallax>
  <Image
    class="bg"
    src={sky.src}
    alt={sky.alt}
    widths={[800, 1200, 1800, 2400]}
    sizes="100vw"
    format="webp"
    quality={72}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="wrap grid top">
    <h1 id="hero-h" class="display" data-reveal>{site.hero.headline}</h1>
    <div class="aside" data-reveal style="--d: 0.12s">
      <p class="body">{site.hero.sub}</p>
      <div class="cta" data-hero-cta>
        <Button href={telHref} icon="phone" size="lg">Call now</Button>
        <Button href={waHref} variant="secondary" icon="whatsapp" size="lg">WhatsApp</Button>
      </div>
    </div>
  </div>
  <Image
    class="fg"
    src={building.src}
    alt={building.alt}
    widths={[1100, 1600, 2000]}
    sizes="(max-width: 720px) 1100px, (max-width: 1100px) 1400px, 100vw"
    format="webp"
    quality={82}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(92vh, 980px);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-block: 225px 32px;
    background: var(--paper);
    overflow: hidden;
  }
  .bg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  .top {
    position: relative;
    z-index: 1;
    align-items: start;
    row-gap: 32px;
  }
  .fg {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 2;
    width: 100%;
    height: auto;
    max-width: none;
    transform: translate3d(-50%, 0, 0);
    pointer-events: none;
  }
  /* Parallax: the sky moves at 0.3x and the text at 0.4x of the scroll speed,
     so the building (1x) climbs over both. Static under reduced motion. */
  :global(html.js) .bg {
    transform: translate3d(0, var(--py, 0px), 0);
    will-change: transform;
  }
  :global(html.js) .top {
    transform: translate3d(0, var(--ty, 0px), 0);
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .bg,
    :global(html.js) .top {
      transform: none;
      will-change: auto;
    }
  }
  h1 {
    grid-column: 1 / span 8;
  }
  .aside {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 14px;
  }
  .aside p {
    max-width: 24em;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cta :global(.secondary) {
    background: color-mix(in srgb, var(--white) 70%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  @media (max-width: 1100px) {
    .hero {
      padding-block: 120px 0;
    }
    h1 {
      grid-column: 1 / -1;
    }
    .aside {
      grid-column: 1 / span 8;
      padding-top: 0;
    }
    /* In flow at the bottom of the hero, so on short screens the building sits
       below the buttons instead of over them; still layered above the text. */
    .fg {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      align-self: center;
      margin-top: auto;
      padding-top: 56px;
      width: max(100%, 1400px);
    }
  }
  @media (max-width: 1100px) and (orientation: portrait) {
    .hero {
      min-height: min(72vh, 860px);
    }
  }
  @media (max-width: 720px) {
    .hero {
      min-height: min(88vh, 820px);
      padding-top: 64px;
    }
    .fg {
      width: 1100px;
      padding-top: 40px;
    }
    .aside {
      grid-column: 1 / -1;
      gap: 22px;
    }
    .cta :global(.btn) {
      height: 54px;
      font-size: 16px;
      flex: 1 1 auto;
    }
  }
</style>
