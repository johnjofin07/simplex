---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { site, telHref, waHref } from '../content/site';
import { photos } from '../content/photos';
const p = photos[site.hero.photo];
---

<section class="hero wrap" id="top" aria-labelledby="hero-h">
  <div class="grid top">
    <h1 id="hero-h" class="display" data-reveal>{site.hero.headline}</h1>
    <div class="aside" data-reveal style="--d: 0.12s">
      <p class="body">{site.hero.sub}</p>
      <div class="cta" data-hero-cta>
        <Button href={telHref} icon="phone" size="lg">Call now</Button>
        <Button href={waHref} variant="secondary" icon="whatsapp" size="lg">WhatsApp</Button>
      </div>
    </div>
  </div>

  <figure class="photo stage" data-reveal style="--d: 0.2s">
    <Image
      src={p.src}
      alt={p.alt}
      widths={[720, 1200, 1800, 2400]}
      sizes="(max-width: 1440px) 100vw, 1440px"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <figcaption class="cap-card">
      <span class="h3">{site.hero.caption.title}</span>
      <span class="small muted">{site.hero.caption.line}</span>
    </figcaption>
    <ul class="strip" aria-label="What we make">
      {site.hero.strip.map((s) => <li>{s}</li>)}
    </ul>
  </figure>
</section>

<style>
  .hero {
    padding-top: 72px;
    padding-bottom: var(--section);
    background: var(--paper);
    max-width: none;
  }
  .top {
    align-items: end;
    row-gap: 32px;
    max-width: calc(var(--max) - 2 * var(--margin));
    margin-inline: auto;
  }
  h1 {
    grid-column: 1 / span 8;
  }
  .aside {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 10px;
  }
  .aside p {
    max-width: 24em;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .stage {
    margin-top: 56px;
    max-width: calc(var(--max) - 2 * var(--margin));
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    max-height: 760px;
    width: 100%;
  }
  .stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 50%;
  }
  .cap-card {
    position: absolute;
    left: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 22px;
    background: var(--white);
    border-radius: var(--r-sm);
    max-width: min(60%, 420px);
  }
  .cap-card .h3 {
    font-size: 20px;
  }
  .strip {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 50%;
  }
  .strip li {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--white) 82%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  @media (max-width: 1100px) {
    h1 {
      grid-column: 1 / -1;
    }
    .aside {
      grid-column: 1 / span 8;
      padding-bottom: 0;
    }
    .stage {
      margin-top: 44px;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-top: 44px;
    }
    .aside {
      grid-column: 1 / -1;
      gap: 22px;
    }
    .cta :global(.btn) {
      height: 54px;
      font-size: 16px;
      flex: 1 1 auto;
    }
    .stage {
      margin-top: 36px;
      aspect-ratio: 4 / 5;
      margin-inline: calc(-1 * var(--margin) + 8px);
      width: auto;
    }
    .cap-card {
      left: 14px;
      bottom: 14px;
      right: 14px;
      max-width: none;
      padding: 14px 16px;
    }
    .cap-card .h3 {
      font-size: 18px;
    }
    .strip {
      display: none;
    }
  }
</style>
