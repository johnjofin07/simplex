---
import { Image } from 'astro:assets';
import { site } from '../content/site';
import { photos } from '../content/photos';
const [lead, ...rest] = site.process.photos;
const leadP = photos[lead.photo];
---

<section class="band paper" id="process" aria-labelledby="process-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="process-h" class="h2" data-reveal style="--d: 0.06s">{site.process.headline}</h2>
      <div class="aside" data-reveal style="--d: 0.12s">
        <p class="body">{site.process.sub}</p>
      </div>
    </div>

    <div class="grid work">
      <figure class="photo lead" data-reveal>
        <Image src={leadP.src} alt={leadP.alt} widths={[600, 1000, 1400]} sizes="(max-width: 1100px) 100vw, 46vw" format="webp" quality={76} loading="lazy" decoding="async" />
        <figcaption class="cap pill">{lead.caption}</figcaption>
      </figure>
      <ol class="steps">
        {site.process.steps.map((s, i) => (
          <li data-reveal style={`--d: ${0.08 * i}s`}>
            <span class="n label">{s.n}</span>
            <div>
              <h3 class="h3">{s.title}</h3>
              <p class="body muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      {rest.map((r, i) => {
        const p = photos[r.photo];
        return (
          <figure class="photo pair" data-reveal style={`--d: ${0.08 * i}s`}>
            <Image src={p.src} alt={p.alt} widths={[600, 1000, 1400]} sizes="(max-width: 720px) 100vw, 40vw" format="webp" quality={76} loading="lazy" decoding="async" />
            <figcaption class="cap pill">{r.caption}</figcaption>
          </figure>
        );
      })}
    </div>
  </div>
</section>

<style>
  .work {
    margin-top: 72px;
    row-gap: var(--gutter);
    align-items: stretch;
  }
  /* The photo shares row 1 with the steps, so the grid's stretch alignment
     makes it exactly as tall as the list beside it: no overhang either way. */
  .lead {
    grid-column: 1 / span 6;
    grid-row: 1;
  }
  .lead img {
    height: 100%;
  }
  .steps {
    grid-column: 7 / span 6;
    grid-row: 1;
    display: flex;
    flex-direction: column;
  }
  .steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    padding-block: 26px;
    border-top: 1px solid var(--line);
  }
  .steps li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .steps h3 {
    margin-bottom: 8px;
  }
  .steps p {
    max-width: 32em;
    font-size: var(--small-size);
    line-height: var(--small-lh);
  }
  .n {
    padding-top: 6px;
    color: var(--ink-2);
  }
  .pair {
    grid-column: span 6;
    aspect-ratio: 3 / 2;
    grid-row: 2;
  }
  .pair:nth-of-type(2) {
    grid-column: 1 / span 6;
  }
  .pair:nth-of-type(3) {
    grid-column: 7 / span 6;
  }
  @media (max-width: 1100px) {
    .work {
      margin-top: 56px;
    }
    .lead {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 16 / 9;
    }
    .steps {
      grid-column: 1 / span 10;
      grid-row: auto;
      margin-top: 24px;
    }
    .pair,
    .pair:nth-of-type(2),
    .pair:nth-of-type(3) {
      grid-column: span 6;
      grid-row: auto;
    }
  }
  @media (max-width: 720px) {
    .work {
      margin-top: 40px;
    }
    .lead {
      aspect-ratio: 4 / 3;
    }
    .steps {
      grid-column: 1 / -1;
      margin-top: 16px;
    }
    .steps li {
      grid-template-columns: 44px 1fr;
      padding-block: 22px;
    }
    .pair,
    .pair:nth-of-type(2),
    .pair:nth-of-type(3) {
      grid-column: 1 / -1;
    }
  }
</style>
