---
/**
 * Every kind of aluminium work. Each card is a folder of photographs: the
 * cover is shown here, and opening the card starts the page's photo viewer on
 * that service's album only. Without JS the card links to the first photo.
 */
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Button from './Button.astro';
import Lightbox from './Lightbox.astro';
import { site, waHref } from '../content/site';
import { serviceAlbums } from '../content/gallery';

// Albums come from src/content/work/ (managed at /admin).
const cards = await Promise.all(
  (await serviceAlbums()).map(async (s) => ({
    ...s,
    album: await Promise.all(
      s.album.map(async (p) => {
        const full = await getImage({ src: p.src, width: 1800, format: 'webp', quality: 80 });
        return { src: full.src, alt: p.alt, caption: p.caption };
      })
    ),
  }))
);
---

<section class="band paper" id="work" aria-labelledby="work-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="work-h" class="h2" data-reveal style="--d: 0.06s">{site.services.headline}</h2>
      <div class="aside" data-reveal style="--d: 0.12s">
        <p class="body">{site.services.sub}</p>
        <div class="ctas">
          <Button href={waHref} icon="whatsapp">Send us a photo of the room</Button>
          <Button href={site.instagram} variant="secondary" icon="instagram">More on Instagram</Button>
        </div>
      </div>
    </div>

    <ul class="cards">
      {cards.map((s, i) => (
        <li class={s.span} data-reveal style={`--d: ${0.06 * (i % 3)}s`}>
          <a class="photo card" href={s.album[0].src} data-lb-album={s.key} aria-label={`${s.title} — open ${s.album.length} photos`}>
            <Image
              src={s.cover.src}
              alt={s.cover.alt}
              widths={[480, 800, 1200, 1600]}
              sizes={s.span === 'full' ? '(max-width: 1440px) 100vw, 1440px' : s.span === 'wide' ? '(max-width: 720px) 100vw, 60vw' : '(max-width: 720px) 100vw, 34vw'}
              format="webp"
              quality={76}
              loading="lazy"
              decoding="async"
            />
            <span class="scrim" />
            <span class="count label" aria-hidden="true"><Icon name="photos" size={16} /> {s.album.length}</span>
            <span class="cap">
              <span class="h3">{s.title}</span>
              <p class="small">{s.text}</p>
              <span class="open small">View photos <Icon name="arrow" size={16} /></span>
            </span>
          </a>
          <script is:inline type="application/json" data-lb-album={s.key} data-lb-title={s.title} set:html={JSON.stringify(s.album)} />
        </li>
      ))}
    </ul>
  </div>
</section>

<Lightbox />

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .count {
    position: absolute;
    top: 16px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.86);
    color: var(--ink);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    font-weight: 600;
    color: var(--white);
    opacity: 0.9;
  }
  .open :global(svg) {
    transition: transform 0.3s var(--ease);
  }
  .card:hover .open :global(svg),
  .card:focus-visible .open :global(svg) {
    transform: translateX(4px);
  }
  .cards {
    margin-top: 72px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .cards li {
    min-width: 0;
  }
  .card {
    display: block;
    width: 100%;
  }
  .wide {
    grid-column: span 7;
  }
  .narrow {
    grid-column: span 5;
  }
  .third {
    grid-column: span 4;
  }
  .full {
    grid-column: 1 / -1;
  }
  .wide .card,
  .narrow .card {
    aspect-ratio: 4 / 3;
  }
  /* Narrow card stretches to the row set by the wide card; its image is
     taken out of flow so its portrait ratio cannot inflate the row height. */
  .narrow .card {
    aspect-ratio: auto;
    height: 100%;
  }
  .narrow .card img {
    position: absolute;
    inset: 0;
  }
  .third .card {
    aspect-ratio: 1 / 1;
  }
  .full .card {
    aspect-ratio: 21 / 9;
  }
  .full .card img {
    object-position: 50% 62%;
  }
  .full .cap p {
    max-width: 40em;
  }
  @media (max-width: 1100px) {
    .cards {
      margin-top: 56px;
    }
    .wide,
    .narrow {
      grid-column: span 6;
    }
    .wide .card,
    .narrow .card {
      aspect-ratio: 4 / 3;
    }
    .third {
      grid-column: span 6;
    }
    .third:last-of-type {
      grid-column: span 6;
    }
    .full .card {
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 720px) {
    .cards {
      margin-top: 40px;
    }
    .wide,
    .narrow,
    .third,
    .full {
      grid-column: 1 / -1;
    }
    .wide .card,
    .narrow .card,
    .third .card,
    .full .card {
      aspect-ratio: 4 / 3;
    }
  }
</style>
