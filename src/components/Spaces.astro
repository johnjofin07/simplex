---
import Icon from './Icon.astro';
import { site } from '../content/site';
---

<section class="band greige" id="spaces" aria-labelledby="spaces-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="spaces-h" class="h2" data-reveal style="--d: 0.06s">{site.spaces.headline}</h2>
      <div class="aside" data-reveal style="--d: 0.12s">
        <p class="body">{site.spaces.sub}</p>
        <div class="steps" data-scroller-controls="spaces-track">
          <button class="step" type="button" data-dir="-1" aria-label="Previous spaces"><Icon name="arrow-left" size={18} /></button>
          <span class="track-line" aria-hidden="true"><span class="thumb" /></span>
          <button class="step" type="button" data-dir="1" aria-label="Next spaces"><Icon name="arrow" size={18} /></button>
        </div>
      </div>
    </div>
  </div>
  <div class="scroller" id="spaces-track" data-scroller tabindex="0" aria-label="Spaces we fit, horizontal list">
    <ul class="track">
      {site.spaces.items.map((s, i) => (
        <li class:list={['card', { dark: i === 1 }]} data-reveal style={`--d: ${0.07 * i}s`}>
          <span class="disc"><Icon name={s.icon} size={22} /></span>
          <div>
            <h3 class="h3">{s.title}</h3>
            <p class="small">{s.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .steps {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: 320px;
  }
  .step {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    display: grid;
    place-items: center;
    transition:
      background-color var(--t-fast) ease,
      color var(--t-fast) ease,
      opacity var(--t-fast) ease;
  }
  .step:hover {
    background: var(--ink);
    color: var(--on-ink);
  }
  .step[disabled] {
    opacity: 0.3;
    pointer-events: none;
  }
  .track-line {
    flex: 1;
    height: 1px;
    background: var(--line);
    position: relative;
  }
  .thumb {
    position: absolute;
    top: -1px;
    left: 0;
    height: 3px;
    width: var(--thumb-w, 40%);
    transform: translateX(var(--thumb-x, 0));
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.4s var(--ease);
  }
  .scroller {
    margin-top: 64px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: max(var(--margin), calc((100vw - var(--max)) / 2 + var(--margin)));
    scroll-padding-inline: max(var(--margin), calc((100vw - var(--max)) / 2 + var(--margin)));
  }
  .scroller::-webkit-scrollbar {
    display: none;
  }
  .track {
    display: flex;
    gap: var(--gutter);
    width: max-content;
    padding-bottom: 4px;
  }
  .card {
    flex: none;
    width: 318px;
    min-height: 300px;
    padding: 26px;
    border-radius: var(--r);
    background: var(--white);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 56px;
    scroll-snap-align: start;
  }
  .card p {
    margin-top: 10px;
    color: var(--ink-2);
  }
  .card.dark {
    background: var(--ink);
    color: var(--on-ink);
  }
  .card.dark p {
    color: var(--on-ink-2);
  }
  .disc {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--on-ink);
  }
  .card.dark .disc {
    background: var(--white);
    color: var(--ink);
  }
  @media (max-width: 1100px) {
    .scroller {
      margin-top: 48px;
    }
  }
  @media (max-width: 720px) {
    .scroller {
      margin-top: 36px;
    }
    .card {
      width: 78vw;
      min-height: 240px;
      gap: 40px;
      padding: 22px;
    }
    .steps {
      max-width: none;
    }
  }
</style>
